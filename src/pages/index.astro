---
import Layout from '../layouts/Layout.astro';

// Every Markdown file under src/pages/blog/ is a post. New posts show up here
// automatically; frontmatter (title, description, pubDate) is optional.
const modules = import.meta.glob('./blog/*.md', { eager: true });

const posts = Object.entries(modules)
  .map(([path, mod]: [string, any]) => {
    const fm = mod.frontmatter ?? {};
    const slug = path.replace(/^\.\/blog\//, '').replace(/\.md$/, '');
    const firstHeading = mod.getHeadings?.().find((h: any) => h.depth === 1)?.text;
    return {
      url: mod.url ?? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/${slug}/`,
      title: fm.title ?? firstHeading ?? slug.replace(/_/g, ' '),
      description: fm.description,
      pubDate: fm.pubDate ? new Date(fm.pubDate) : undefined,
    };
  })
  // Newest first; undated posts go last, alphabetically.
  .sort((a, b) => {
    if (a.pubDate && b.pubDate) return b.pubDate.getTime() - a.pubDate.getTime();
    if (a.pubDate) return -1;
    if (b.pubDate) return 1;
    return a.title.localeCompare(b.title);
  });

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Layout title="Xavier Wei's Technical Blog">
  <header class="intro">
    <h1>Xavier Wei's Technical Blog</h1>
    <p>Notes on AI infra, TPU kernels, and LLM inference.</p>
    <p>Contact: <a href="mailto:isaacwxf23@gmail.com">isaacwxf23@gmail.com</a></p>
  </header>

  <section>
    <h2>Posts</h2>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={post.url}>{post.title}</a>
          {post.pubDate && (
            <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
          )}
          {post.description && <p>{post.description}</p>}
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .intro {
    margin-bottom: 40px;
  }

  .intro p {
    color: #57606a;
    margin: 4px 0 0;
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .posts li {
    padding: 16px 0;
    border-bottom: 1px solid #d8dee4;
  }

  .posts a {
    font-size: 1.15em;
    font-weight: 600;
    text-decoration: none;
  }

  .posts a:hover {
    text-decoration: underline;
  }

  .posts time {
    display: block;
    color: #57606a;
    font-size: 0.875em;
  }

  .posts p {
    margin: 4px 0 0;
  }
</style>
