---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
// Pages pass `title`; Markdown posts using this layout pass their `frontmatter`.
const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? "Xavier Wei's Technical Blog";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
  <body>
    <main>
      {frontmatter && <nav class="home-link"><a href={base}>&larr; All posts</a></nav>}
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
      Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.65;
    color: #24292f;
    background: #ffffff;
  }

  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  /* Inline code: `block_size` */
  :not(pre) > code {
    background-color: #eff1f3;
    padding: 0.15em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* Code blocks */
  pre {
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
  }

  /* Images */
  img {
    max-width: 100%;
    height: auto;
  }

  /* Headings */
  h1,
  h2,
  h3 {
    line-height: 1.25;
  }

  h1 {
    margin-top: 0;
  }

  .home-link {
    margin-bottom: 24px;
    font-size: 0.9em;
  }

  /* Links */
  a {
    color: #0969da;
  }
</style>
